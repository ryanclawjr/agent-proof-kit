#!/usr/bin/env bash
# secret-scan [DIR...]: gitleaks over skills, prompts, records and logs. Exit 1 on any finding.
# Uses config/secret-scan.toml (defaults + a documented allowlist: every entry needs a reason).
# Creates ${PROOF_DIR:-proof}/secret-scan/ if missing. Writes a redacted report (rule + file only) to ${PROOF_DIR:-proof}/secret-scan/. Never prints secret values.
set -u
here=$(cd "$(dirname "$0")/.." && pwd); CFG=${SECRET_SCAN_CONFIG:-$here/config/secret-scan.toml}
GL=${GITLEAKS:-gitleaks}; command -v "$GL" >/dev/null || { echo "gitleaks not found: https://github.com/gitleaks/gitleaks#installing"; exit 2; }
OUT=${PROOF_DIR:-proof}/secret-scan; mkdir -p "$OUT"; D=$(date +%F); rc=0
[ $# -eq 0 ] && set -- .
for t in "$@"; do n=$(echo "$t" | tr '/.' '__'); r="$OUT/$D-$n.json"
  [ -e "$t" ] || { echo "$t: not found, skipped"; continue; }
  "$GL" dir "$t" --no-banner --redact -c "$CFG" --max-target-megabytes 5 -f json -r "$r" >/dev/null 2>&1 || rc=1
  [ -s "$r" ] || { echo "$t: gitleaks wrote no report (scan error) -> FAIL"; rc=1; continue; }
  python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(sys.argv[2],len(d),'findings');[print('  ',x['RuleID'],x['File']) for x in d]" "$r" "$t"
done
echo "{\"ts\":\"$(date -Iseconds)\",\"verdict\":\"$([ $rc = 0 ] && echo PASS || echo FAIL)\"}" >> "$OUT/runs.jsonl"; exit $rc

#!/usr/bin/env python3
"""judge-check <dir|file.eval.json>
Test the judge, not the agent. Feeds every `planted_bad_answers` entry straight to JUDGE_CMD.
A judge that passes any planted bad answer is broken: exit 3. Run it whenever you change the
judge command, model, or prompt, and nightly.
Try it:  JUDGE_CMD="bin/mock-judge --lazy" bin/judge-check examples   # a rubber-stamp judge -> exit 3"""
import glob, os, sys
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
from evallib import load_spec
import importlib.machinery, importlib.util
ld = importlib.machinery.SourceFileLoader("run_evals", os.path.join(HERE, "run-evals"))
spec_ = importlib.util.spec_from_loader("run_evals", ld); re_ = importlib.util.module_from_spec(spec_); ld.exec_module(re_)
a = sys.argv[1:]
if not a or a[0] in ("-h", "--help"):
    print("usage: judge-check <dir|file.eval.json>   (no eval set given; nothing was checked)\n" + __doc__, file=sys.stderr); sys.exit(2)
t = a[0]; files = sorted(glob.glob(os.path.join(t, "**", "*.eval.json"), recursive=True)) if os.path.isdir(t) else [t]
if not files: print(f"judge-check: no *.eval.json at {t}", file=sys.stderr); sys.exit(2)
missed = total = 0
for f in files:
    for c in load_spec(f)["cases"]:
        for p in c.get("planted_bad_answers") or []:
            r = re_.run_planted(c, p); total += 1; missed += not r["caught_by_judge"]
            print(f"  {'CAUGHT' if r['caught_by_judge'] else 'MISSED'} {c['id']}:{p.get('id')}  judge={r.get('judge_verdict')}" + (f" ERROR {r['error']}" if 'error' in r else ""))
print(f"judge caught {total - missed}/{total} planted bad answers ->", "PASS" if total and not missed else "FAIL")
sys.exit(0 if total and not missed else 3)
